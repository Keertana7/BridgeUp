# Supabase project URL — found in Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — found in Supabase Dashboard > Settings > API
SUPABASE_KEY=your-anon-public-key-here

# NOTE: SUPABASE_JWT_SECRET is NOT required when using the new ECC (ES256) signing keys.
# FastAPI verifies tokens using the public JWKS endpoint at:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# No secret key needs to be stored here for authentication.

# Server-side ingestion credentials. Never expose the service-role key to clients.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Read-only JSON endpoint returning Google Form responses as a list of objects.
GOOGLE_SHEET_API_URL=https://example.invalid/form-responses
