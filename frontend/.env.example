# Primary FastAPI app (companies, experiences, questions, advice, resources, auth)
VITE_API_URL=http://localhost:8001

# Secondary FastAPI app (AI question generation, chat) — only if running separately
VITE_AI_API_URL=http://localhost:8000

# Supabase public credentials — used for client-side auth (sign-in / sign-up)
# These are your project's anon/public keys — safe to expose in the browser
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
