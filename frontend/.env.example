# Supabase project URL — Supabase Dashboard > Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — Supabase Dashboard > Settings > API > anon public
# This is the PUBLIC key. It is safe to use in the browser.
# NEVER use the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# FastAPI backend base URL
VITE_API_URL=http://localhost:8000
